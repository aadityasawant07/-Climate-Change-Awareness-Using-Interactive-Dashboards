# Environment Variables Configuration for EcoPulse Climate Intelligence Hub

# The application utilizes Open-Meteo's free, public, and keyless global weather & air-quality APIs by default.
# If you wish to configure a custom OpenWeatherMap API key, define it below:
VITE_OPENWEATHER_API_KEY=

# Optional custom Mapbox or OpenAQ key
VITE_OPENAQ_API_KEY=
